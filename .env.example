# WhatsApp Business number in international format, no + or spaces, e.g. 2348012345678
NEXT_PUBLIC_WHATSAPP_NUMBER=2340000000000

# Public contact details shown in footer / about / trust sections
NEXT_PUBLIC_COMPANY_EMAIL=hello@example.com
NEXT_PUBLIC_COMPANY_PHONE=+234 000 000 0000
NEXT_PUBLIC_COMPANY_ADDRESS=Lagos, Nigeria

# Where /api/quote should deliver submitted quote requests.
# Currently the route only logs the payload -- wire this up to
# email (e.g. Resend, Nodemailer) or a database before going live.
QUOTE_NOTIFICATION_EMAIL=sales@example.com

# --- Admin dashboard / CMS (Supabase) ---------------------------------
# Project Settings -> API in your Supabase dashboard.
# The anon key is safe to expose (NEXT_PUBLIC_) -- Row Level Security in
# supabase/migrations is what actually restricts access, not this key.
# There is no service-role key here on purpose: nothing in this app needs
# to bypass Row Level Security, so it's never generated or stored.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
